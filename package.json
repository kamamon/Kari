{
  "name": "veilbound-hunters",
  "private": true,
  "version": "0.72.0",
  "description": "霧境の狩人 - VEILBOUND HUNTERS / 横画面・三人称3Dのオリジナル狩猟アクション",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spinegale:build": "node tools/spinegale/ensure.mjs",
    "predev": "npm run spinegale:build",
    "prebuild": "npm run spinegale:build",
    "pretest": "npm run spinegale:build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:validate": "vitest run tests/content.test.ts",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "bestiary:import": "node --experimental-strip-types --no-warnings tools/bestiary-import.mjs",
    "bestiary:thumbs": "python3 tools/concept-thumbs.py",
    "env:art": "python3 tools/env-art.py",
    "rocks:art": "python3 tools/rock-art.py",
    "supplement:art": "python3 tools/supplement-art.py",
    "equipment:gen": "python3 -I tools/gen-equipment.py",
    "field:gen": "python3 tools/gen-field.py",
    "hub:gen": "python3 tools/gen-hub.py",
    "props:art": "python3 tools/prop-art.py",
    "monsters:gen": "python3 tools/gen-monsters.py && npm run monsters:bake",
    "monsters:bake": "CREATURE_BAKE=1 vitest run tests/creature-motion.test.ts",
    "monsters:art": "python3 tools/monster-art.py",
    "hunter:masks": "python3 tools/hunter-masks.py",
    "design:doc": "python3 tools/design-doc/build.py tools/out/design-v2.html docs/design-v2/monsters && node tools/design-doc/pdf.mjs tools/out/design-v2.html docs/source/VEILBOUND_HUNTERS_design_v2.0.pdf",
    "publish:pages": "bash tools/publish-pages.sh",
    "preassets:validate": "npm run spinegale:build"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
