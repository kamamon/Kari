+function temperamentAt(seed: number, index: number): HerdTemperament {
+  let n = (seed ^ Math.imul((index >>> 2) + 1, 0x9e3779b9)) >>> 0;
+  n = Math.imul(n ^ (n >>> 16), 0x85ebca6b);
+  n = Math.imul(n ^ (n >>> 13), 0xc2b2ae35);
+  n ^= n >>> 16;
+  // 2頭なら臆病+攻撃的、3頭なら各1、4頭なら臆病1/慎重2/攻撃的1。
