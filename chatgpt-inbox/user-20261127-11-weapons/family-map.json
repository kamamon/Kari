  "integration": {
    "required": [
      "public/data/weapons.json",
      "public/data/actions/<family>.json",
      "tools/weapons/<family>.mjs",
      "src/render/rig.ts",
      "src/render/hunterAnim.ts",
      "src/render/view.ts",
      "src/game/player.ts",
      "src/game/sim.ts",
      "src/data/schemas.ts",
      "UI weapon category selection / smithy / inventory / save schema",
      "projectiles, shelling, melody buff and audio VFX where appropriate",
      "test cases for all 11 class IDs"
    ],
    "acceptance": [
      "11 distinct equippable categories with starter weapon each",
      "Existing 7 and saved equipped weapons deserialize unchanged",
      "3D blockout GLBs and hand/offhand socket transforms load correctly",
      "No default heavy_blade fallback for new classes",
      "Ammo/recital/shot cooldown persists and works after interruptions",
      "No duplicate hit from one active hit window",
      "All 11 are selectable on touch/iPhone and visible in smithy",
      "30 fps mobile and 60 fps simulation stability after integration"
    ]
  },
